requirements_alpine_libs_install()
{
  __rvm_try_sudo apk add --update --no-cache --no-interactive "$@" || return $?
}

requirements_alpine_libs_remove()
{
  __rvm_try_sudo apk --no-interactive del "$@" || return $?
}

requirements_alpine_update_system()
{
  __rvm_try_sudo apk --quiet --no-interactive update  || return $?
}

