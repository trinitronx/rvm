#!/usr/bin/env bash

requirements_alpine_lib_installed()
{
  local _pkg="$(apk --no-interactive --no-cache --quiet list --installed "$1")"
  [ -z "$_pkg" ] && return 1 || return 0
}

requirements_alpine_lib_available()
{
  local _pkg="$(apk --no-interactive --no-cache --quiet list --available "$1")"
  [ -z "$_pkg" ] && return 1 || return 0
}

